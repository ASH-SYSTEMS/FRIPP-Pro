      "asi-lo-p1-p2":            { "id": "asi-lo-p1-p2",            "originatingActivity": "proc-lo-p1",            "usedByActivity": "proc-lo-p2" },
      "asi-lo-p2-p3":            { "id": "asi-lo-p2-p3",            "originatingActivity": "proc-lo-p2",            "usedByActivity": "proc-lo-p3" },
