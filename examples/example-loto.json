            "id": "pg-lo-zero-energy",
            "description": "Zero Energy State Verified",
            "type": "UNCONTROLLABLE",
            "leafProbability": 0.1,
            "childIds": [],
            "criticalThreshold": null, "notifyMode": "NOTIFY_ONLY", "stakeholders": []
          },
          "pg-lo-compliance": {
