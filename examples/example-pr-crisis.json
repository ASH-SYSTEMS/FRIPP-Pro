      "act-pr-social":      { "id": "act-pr-social",      "name": "Social Media Manager",   "actuatorType": "HUMAN" },
      "act-pr-legal":       { "id": "act-pr-legal",       "name": "Legal Counsel",          "actuatorType": "HUMAN" },
      "act-pr-monitoring":  { "id": "act-pr-monitoring",  "name": "Social Listening Platform", "actuatorType": "MACHINE" }
    },
    "externalReferences": {},
