      "asi-pr-board-done":       { "id": "asi-pr-board-done",       "originatingActivity": "proc-pr-notify-board",     "usedByActivity": "proc-pr-choose-stance" },
      "asi-pr-statement-live":   { "id": "asi-pr-statement-live",   "originatingActivity": "proc-pr-publish-external", "usedByActivity": "proc-pr-brief-staff" },
      "asi-pr-sentiment-tracked":{ "id": "asi-pr-sentiment-tracked","originatingActivity": "proc-pr-track-sentiment",  "usedByActivity": "proc-pr-hr-investigation" },
      "asi-pr-crisis-resolved":  { "id": "asi-pr-crisis-resolved",  "originatingActivity": "proc-pr-hr-investigation", "usedByActivity": null },
      "asi-pr-p1-p2":            { "id": "asi-pr-p1-p2",            "originatingActivity": "proc-pr-p1",               "usedByActivity": "proc-pr-p2" },
      "asi-pr-p2-p3":            { "id": "asi-pr-p2-p3",            "originatingActivity": "proc-pr-p2",               "usedByActivity": "proc-pr-p3" },
      "asi-pr-p3-p4":            { "id": "asi-pr-p3-p4",            "originatingActivity": "proc-pr-p3",               "usedByActivity": "proc-pr-p4" }
    },
    "actuators": {
