    },
    "roles": {
      "role-pr-comms":  { "id": "role-pr-comms",  "name": "Communications Lead", "description": "Owns the public narrative; drafts and approves all statements", "actuatorIds": ["act-pr-comms"] },
      "role-pr-social": { "id": "role-pr-social",  "name": "Social Media Manager", "description": "Monitors social channels and publishes approved content", "actuatorIds": ["act-pr-social", "act-pr-monitoring"] },
      "role-pr-legal":  { "id": "role-pr-legal",   "name": "Legal Counsel",        "description": "Reviews all public statements for legal risk and advises on response stance", "actuatorIds": ["act-pr-legal"] }
